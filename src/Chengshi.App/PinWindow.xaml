<Window x:Class="Chengshi.App.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="家长密码"
        Height="430"
        Width="400"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        FocusManager.FocusedElement="{Binding ElementName=PinBox}">
  <Border Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Margin="1">
    <Grid Margin="30,26,30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Canvas Width="22" Height="22" VerticalAlignment="Center">
          <Path Data="M 11,2 L 19,8 L 15.5,9.5 L 13.5,8.5 L 13.5,16 L 8.5,16 L 8.5,8.5 L 6.5,9.5 L 3,8 Z"
                Fill="{StaticResource AccentBrush}"/>
        </Canvas>
        <TextBlock x:Name="TitleText"
                   Text="家长密码"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="PromptText"
                 Grid.Row="1"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="13"
                 Margin="0,8,0,20"/>

      <StackPanel Grid.Row="2">
        <StackPanel x:Name="VerifyPanel">
          <PasswordBox x:Name="PinBox"
                       Style="{StaticResource FieldPassword}"
                       InputMethod.IsInputMethodEnabled="False"/>
          <CheckBox x:Name="ShowPinBox"
                    Content="显示密码"
                    Style="{StaticResource QuietCheck}"
                    Margin="0,12,0,0"
                    Checked="ShowPin_Changed"
                    Unchecked="ShowPin_Changed"/>
          <TextBox x:Name="PinPlainBox"
                   Style="{StaticResource SearchBox}"
                   Visibility="Collapsed"
                   InputMethod.IsInputMethodEnabled="False"
                   Tag="家长密码"/>
          <Button Content="忘记密码"
                  Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left"
                  Padding="0,12,0,0"
                  Click="Forgot_Click"/>
          <Button Content="用邮箱找回密码"
                  Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left"
                  Padding="0,12,0,0"
                  Click="EmailForgot_Click"/>
        </StackPanel>

        <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
          <TextBlock Text="找回码"
                     Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="RecoveryBox"
                   Style="{StaticResource SearchBox}"
                   Tag="设置时抄下的找回码"/>
          <TextBlock Text="新密码（至少 4 位）"
                     Style="{StaticResource FieldLabel}"
                     Margin="0,16,0,6"/>
          <PasswordBox x:Name="NewPinBox"
                       Style="{StaticResource FieldPassword}"
                       InputMethod.IsInputMethodEnabled="False"/>
          <TextBlock Text="再输一次新密码"
                     Style="{StaticResource FieldLabel}"
                     Margin="0,12,0,6"/>
          <PasswordBox x:Name="NewPinConfirmBox"
                       Style="{StaticResource FieldPassword}"
                       InputMethod.IsInputMethodEnabled="False"/>
        </StackPanel>

        <StackPanel x:Name="EmailRecoveryPanel" Visibility="Collapsed">
          <TextBlock Text="用预留的备用邮箱找回密码"
                     Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="EmailBox"
                   Style="{StaticResource SearchBox}"
                   InputMethod.IsInputMethodEnabled="False"
                   Tag="备用邮箱"/>
          <Button Content="发送验证码"
                  Style="{StaticResource OutlineButton}"
                  Margin="0,10,0,0"
                  Click="EmailSend_Click"/>
          <TextBlock Text="6 位验证码"
                     Style="{StaticResource FieldLabel}"
                     Margin="0,16,0,6"/>
          <TextBox x:Name="EmailCodeBox"
                   Style="{StaticResource SearchBox}"
                   InputMethod.IsInputMethodEnabled="False"
                   Tag="6 位验证码"/>
          <TextBlock Text="新密码（至少 4 位）"
                     Style="{StaticResource FieldLabel}"
                     Margin="0,16,0,6"/>
          <PasswordBox x:Name="EmailNewPinBox"
                       Style="{StaticResource FieldPassword}"
                       InputMethod.IsInputMethodEnabled="False"/>
          <TextBlock Text="再输一次新密码"
                     Style="{StaticResource FieldLabel}"
                     Margin="0,12,0,6"/>
          <PasswordBox x:Name="EmailNewPinConfirmBox"
                       Style="{StaticResource FieldPassword}"
                       InputMethod.IsInputMethodEnabled="False"/>
          <Button Content="验证并重置"
                  Style="{StaticResource PrimaryButton}"
                  Margin="0,16,0,0"
                  Click="EmailReset_Click"/>
          <TextBlock x:Name="EmailHint"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0"/>
          <Button Content="返回"
                  Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left"
                  Padding="0"
                  Margin="0,12,0,0"
                  Click="EmailBack_Click"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource WarnBrush}"
                   FontSize="13"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <DockPanel x:Name="OkCancelPanel" Grid.Row="3" Margin="0,20,0,0">
        <Button x:Name="OkButton"
                DockPanel.Dock="Right"
                Content="确定"
                Style="{StaticResource PrimaryButton}"
                Click="Ok_Click"
                IsDefault="True"
                MinWidth="92"/>
        <Button Content="取消"
                Style="{StaticResource GhostButton}"
                Click="Cancel_Click"
                IsCancel="True"
                HorizontalAlignment="Left"
                Padding="0"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>

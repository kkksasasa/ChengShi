<Window x:Class="Chengshi.App.AppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="添加软件"
        Height="640"
        Width="480"
        MinHeight="480"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Margin="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <TextBlock Text="选择允许打开的软件"
                   FontSize="15"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="24,0,0,0"/>
        <Button Content="×"
                Style="{StaticResource ChromeButton}"
                HorizontalAlignment="Right"
                Click="Close_Click"
                FontSize="16"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
      </Grid>

      <DockPanel Grid.Row="1" Margin="24,16,24,0">
        <TextBox x:Name="SearchBox"
                 DockPanel.Dock="Top"
                 Style="{StaticResource SearchBox}"
                 Margin="0,0,0,12"
                 TextChanged="SearchBox_TextChanged"/>
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="正在查找本机软件…"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Margin="0,0,0,10"/>
        <ListBox x:Name="AppList"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource PickerItem}"
                 SelectionMode="Single">
          <ListBox.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="RowBd" CornerRadius="10" Padding="8,2,8,2" Background="Transparent">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Style="{StaticResource QuietCheck}"
                          Margin="4,6"
                          AutomationProperties.Name="{Binding Title}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </CheckBox>
              </Border>
              <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="RowBd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Row="2" Margin="24,16,24,24">
        <Button DockPanel.Dock="Right"
                Content="完成"
                Style="{StaticResource PrimaryButton}"
                Click="Complete_Click"
                MinWidth="88"/>
        <Button Content="从文件添加"
                Style="{StaticResource OutlineButton}"
                HorizontalAlignment="Left"
                Click="Browse_Click"
                ToolTip="绿色便携版、绿色软件等不在开始菜单里的程序，直接选 exe。"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>

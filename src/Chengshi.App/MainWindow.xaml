<Window x:Class="Chengshi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="澄时"
        Height="800"
        Width="1200"
        MinHeight="680"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== 标题栏 ===== -->
      <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Canvas Width="20" Height="20" VerticalAlignment="Center">
            <Path Data="M 10,1 L 17,7 L 14,8.5 L 12.5,7.5 L 12.5,14 L 7.5,14 L 7.5,7.5 L 6,8.5 L 3,7 Z"
                  Fill="{StaticResource AccentBrush}"/>
          </Canvas>
          <TextBlock Text="澄时"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"/>
          <Border x:Name="TitlePillBorder"
                  Style="{StaticResource StatusPill}"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="TitlePillDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TitlePillText"
                         Text="未设置"
                         FontSize="12"
                         Foreground="{StaticResource AccentBrush}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <!-- 守护中由代码隐藏：孩子点了也不会退出，与其让他反复试，不如不给这个按钮。 -->
          <Button x:Name="CloseButton" Content="×" Style="{StaticResource ChromeButton}" Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" FontSize="16"/>
        </StackPanel>
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边导航 ===== -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource SideBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="22,26,22,24">
              <TextBlock Text="守护中心"
                         Foreground="{StaticResource SideActiveBrush}"
                         FontSize="13"
                         FontWeight="SemiBold"/>
              <TextBlock Text="屏幕时间 · 软件白名单"
                         Foreground="{StaticResource SideMutedBrush}"
                         FontSize="11"
                         Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
              <RadioButton x:Name="NavDashboard"
                           GroupName="Nav"
                           Style="{StaticResource NavButton}"
                           IsChecked="True"
                           AutomationProperties.Name="仪表盘"
                           Checked="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M 3,3 H 7 V 7 H 3 Z M 9,3 H 13 V 7 H 9 Z M 3,9 H 7 V 13 H 3 Z M 9,9 H 13 V 13 H 9 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                        Width="15" Height="15" Stretch="Fill" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <!-- 全局 TextBlock 隐式样式是墨色，会盖过模板继承的前景；这里必须显式绑定。 -->
                  <TextBlock Text="仪表盘" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavSettings"
                           GroupName="Nav"
                           Style="{StaticResource NavButton}"
                           AutomationProperties.Name="守护设置"
                           Checked="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <Canvas Width="15" Height="15" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M 2,4 H 14 M 2,8 H 14 M 2,12 H 14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="8.5" Canvas.Top="2"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="3.5" Canvas.Top="6"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="8.5" Canvas.Top="10"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  </Canvas>
                  <TextBlock Text="守护设置" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NavHelp"
                           GroupName="Nav"
                           Style="{StaticResource NavButton}"
                           AutomationProperties.Name="帮助"
                           Checked="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="15" Height="15" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                             StrokeThickness="1.6"/>
                    <Rectangle Width="1.8" Height="1.8" RadiusX="1" RadiusY="1" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,2.6,0,0"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <Rectangle Width="1.8" Height="5.5" RadiusX="1" RadiusY="1" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,0.5,0,0"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  </Grid>
                  <TextBlock Text="帮助" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <Border Grid.Row="2" Margin="16,0,16,20" Padding="14,12"
                    Background="{StaticResource SideHoverBrush}" CornerRadius="10">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="#7FB59B" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SideEngineText"
                             Text="守护引擎"
                             Foreground="{StaticResource SideMutedBrush}"
                             FontSize="12"
                             Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SideEngineDetail"
                           Text="正在检查…"
                           Foreground="{StaticResource SideMutedBrush}"
                           FontSize="11"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           LineHeight="16"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Column="1">
          <Grid x:Name="ParentHost" Margin="28,24,28,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 仪表盘页 ===== -->
            <Grid x:Name="DashboardPage" Grid.Row="0" Grid.RowSpan="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,18">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Canvas Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Ellipse Width="64" Height="64" Fill="{StaticResource AccentSoftBrush}"/>
                    <Path Data="M 32,16 C 26,16 22,20 22,26 C 22,31 26,34 31,35 L 31,46 L 33,46 L 33,35 C 38,34 42,31 42,26 C 42,20 38,16 32,16 Z"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path Data="M 32,10 L 32,13 M 48,26 L 51,26 M 16,26 L 19,26 M 43,15 L 45,13 M 21,15 L 19,13"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                  </Canvas>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingText"
                               Text="你好"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeroSummaryText"
                               Text=""
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="0,0,6,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- 三张书桌模板卡：点一下跳到设置里挑软件（对应设计稿 ui-01） -->
                <UniformGrid Grid.Row="0" Grid.ColumnSpan="3" Columns="3" Margin="0,0,0,18">
                  <Button Style="{StaticResource DeskCardButton}" Margin="0,0,10,0"
                          Click="DashboardToSettings_Click"
                          AutomationProperties.Name="写作业书桌，去设置调整">
                    <StackPanel>
                      <Grid>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                            <Path Data="M 4,19 L 20,19 M 6,16 L 16,6 L 19,9 L 9,19 Z M 15,7 L 18,10"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Text="写作业" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#F6EFEA" BorderBrush="#EAD9CE" BorderThickness="1"
                                CornerRadius="8" Padding="7,3">
                          <TextBlock Text="已断网" FontSize="10" Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                      </Grid>
                      <TextBlock x:Name="DeskCardHomeworkSummary"
                                 Text="文档 + 词典 + 计算器"
                                 Foreground="{StaticResource MutedBrush}" FontSize="12"
                                 Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource DeskCardButton}" Margin="0,0,10,0"
                          Click="DashboardToSettings_Click"
                          AutomationProperties.Name="网课书桌，去设置调整">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                          <Path Data="M 3,5 L 21,5 L 21,15 L 3,15 Z M 8,19 L 16,19 M 12,15 L 12,19"
                                Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Width="22" Height="22" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="网课" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="DeskCardClassSummary"
                                 Text="浏览器 + 笔记"
                                 Foreground="{StaticResource MutedBrush}" FontSize="12"
                                 Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource DeskCardButton}"
                          Click="DashboardToSettings_Click"
                          AutomationProperties.Name="编程书桌，去设置调整">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                          <Path Data="M 9,8 L 4,12 L 9,16 M 15,8 L 20,12 L 15,16"
                                Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Width="22" Height="22" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="编程" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="DeskCardCodeSummary"
                                 Text="IDE + 终端"
                                 Foreground="{StaticResource MutedBrush}" FontSize="12"
                                 Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>

                <!-- 每日屏幕时间：剩余圆环 + 周内/周末两档 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="24,22">
                  <StackPanel>
                    <TextBlock Text="每日屏幕时间" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="128" Height="128" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource RingTrackBrush}" StrokeThickness="13"/>
                        <Path x:Name="DonutProgress"
                              Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="13"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock x:Name="DonutRemainingText"
                                     Text="—"
                                     FontFamily="{StaticResource DisplayFont}"
                                     FontSize="26"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Center"/>
                          <TextBlock Text="剩余"
                                     Foreground="{StaticResource MutedBrush}"
                                     FontSize="11"
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="DonutUsedText"
                                   Text="已用 — / 共 1 小时"
                                   FontSize="15"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="DonutHintText"
                                   Text=""
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12"/>
                        <TextBlock x:Name="WeekdayLimitText" Text="周内每天 1 小时" FontSize="13"/>
                        <TextBlock x:Name="WeekendLimitText" Text="周末每天 2 小时" FontSize="13" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- 最近七天用量：竖向柱状图（对应设计稿 ui-01） -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="24,22">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="最近七天用量" Style="{StaticResource SectionLabel}" Margin="0"/>
                      <TextBlock Text="每天用了多久"
                                 FontSize="11" Foreground="{StaticResource FaintBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="WeekUsageList" Margin="0,4,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="3,0" ToolTip="{Binding Summary}"
                                AutomationProperties.Name="{Binding Summary}">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="110"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Width="24" Height="{Binding BarHeight}"
                                    Background="{StaticResource AccentBrush}" CornerRadius="6"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Label}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WeekUsageEmpty"
                               Text="跨天之后，这里会画出每天大概用了多久。"
                               Foreground="{StaticResource FaintBrush}"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 底部主操作行 -->
                <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0" LastChildFill="False">
                  <Button x:Name="DashboardGuardButton"
                          DockPanel.Dock="Left"
                          Content="完成家长设置"
                          Style="{StaticResource PrimaryButton}"
                          MinWidth="200"
                          MinHeight="46"
                          FontSize="15"
                          Click="DashboardGuard_Click"/>
                  <Button x:Name="RewardButton"
                          DockPanel.Dock="Right"
                          Content="奖励 15 分钟"
                          Style="{StaticResource GhostButton}"
                          Margin="0,14,0,0"
                          Visibility="Collapsed"
                          Click="Reward_Click"/>
                </DockPanel>

                <!-- 最近拦截 -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="最近拦截" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="DashboardBlockedList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#F6EFEA" BorderBrush="#EAD9CE" BorderThickness="1"
                                  CornerRadius="8" Padding="10,5" Margin="0,0,8,8">
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource WarnBrush}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DashboardBlockedEmpty"
                               Text="守护中拦下的软件会显示在这里。"
                               Foreground="{StaticResource FaintBrush}"
                               FontSize="12"/>
                  </StackPanel>
                </Border>

                <!-- 当前书桌 -->
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="当前书桌" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="DashboardDeskName"
                               Text="写作业"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DashboardDeskSummary"
                               Text=""
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,6,0,12"/>
                    <ItemsControl x:Name="DashboardDeskApps">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       AutomationProperties.Name="{Binding DisplayName}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DashboardDeskEmpty"
                               Text="还没选书桌。"
                               Foreground="{StaticResource FaintBrush}"
                               FontSize="12"/>
                    <Button Content="去调整 →"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Padding="0,10,0,0"
                            Click="DashboardToSettings_Click"/>
                  </StackPanel>
                </Border>

                <!-- 守护引擎 -->
                <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="守护引擎" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="EngineStatusText"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                    <TextBlock x:Name="DashboardHintText"
                               Text=""
                               FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                <!-- 今天各软件用了多久（按软件单独限时的配套视图） -->
                <Border Grid.Row="5" Grid.ColumnSpan="3"
                        Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="今天各软件用了多久" Style="{StaticResource SectionLabel}" Margin="0"/>
                      <TextBlock x:Name="AppUsageHint"
                                 Text=""
                                 Foreground="{StaticResource MutedBrush}"
                                 FontSize="12"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="AppUsageList" Margin="0,2,0,0">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,7,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="160"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                              <Border Height="8" CornerRadius="4"
                                      Background="{StaticResource RingTrackBrush}"/>
                              <Border Height="8" CornerRadius="4"
                                      Background="{Binding BarBrush}"
                                      Width="{Binding BarWidth}"
                                      HorizontalAlignment="Left"/>
                            </Grid>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Summary}"
                                       FontSize="12"
                                       Foreground="{Binding SummaryBrush}"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AppUsageEmpty"
                               Text="守护开始后，这里会记下每个软件各用了多久。"
                               Foreground="{StaticResource FaintBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              </ScrollViewer>
            </Grid>

            <!-- ===== 守护设置页 ===== -->
            <Grid x:Name="SettingsPage" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,180,0">
                  <TextBlock x:Name="ParentTitle"
                             Text="家长设置"
                             FontFamily="{StaticResource DisplayFont}"
                             FontSize="26"
                             FontWeight="SemiBold"/>
                  <TextBlock x:Name="ParentLead"
                             Text="改时长或软件后点开始守护。孩子在守护画面里改不了。"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="13"
                             Margin="0,8,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="GuardButton"
                        Content="开始守护"
                        Style="{StaticResource PrimaryButton}"
                        Click="Guard_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="120"/>
              </Grid>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="292"/>
                </Grid.ColumnDefinitions>

                <!-- 场景 + 软件 + 网站 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24,22">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <TextBlock Text="使用场景" Style="{StaticResource SectionLabel}"/>
              <ListBox x:Name="DeskList"
                       Height="142"
                       Margin="-6,0"
                       BorderThickness="0"
                       Background="Transparent"
                       Padding="0"
                       KeyboardNavigation.TabNavigation="Once"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource DeskItem}"
                       SelectionChanged="DeskList_SelectionChanged">
                <ListBox.Resources>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>

              <TextBlock Text="拿不准？一键套用推荐组合：" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="小学生 · 写作业 1 小时" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Tag="homework|60" Click="Preset_Click"/>
                <Button Content="初中生 · 网课 1.5 小时" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Tag="class|90" Click="Preset_Click"/>
                <Button Content="高中生 · 编程 2 小时" Style="{StaticResource OutlineButton}" Tag="code|120" Click="Preset_Click"/>
              </StackPanel>

                      <Grid Margin="0,26,0,0">
                        <TextBlock Text="允许的软件" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <Button x:Name="AddAppsButton"
                                Content="添加 / 去掉"
                                Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="AddApps_Click"/>
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <ItemsControl x:Name="AppChips">
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                              <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,8,8"
                                      Padding="12,6,8,6"
                                      BorderBrush="{StaticResource LineBrush}"
                                      BorderThickness="1"
                                      CornerRadius="9"
                                      Background="{StaticResource SurfaceHoverBrush}"
                                      AutomationProperties.Name="{Binding DisplayName}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding DisplayName}"
                                             FontSize="13"
                                             VerticalAlignment="Center"/>
                                  <Button Content="×"
                                          Style="{StaticResource ChipRemove}"
                                          Tag="{Binding}"
                                          Click="RemoveApp_Click"
                                          ToolTip="从允许名单拿掉"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyAppsText"
                                   Text="还没选软件。开始守护前至少加一款。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Visibility="Collapsed"/>
                      </Grid>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,18"/>

                      <TextBlock Text="网站规则（绿色上网）" Style="{StaticResource SectionLabel}"/>
                      <TextBlock x:Name="SitesHintText"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 LineHeight="18"
                                 Margin="0,0,0,12"/>

                      <TextBlock Text="允许的网站（留空 = 不限制）" Style="{StaticResource FieldLabel}"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteAllowBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchBox}"
                                 Tag="如 ke.qq.com（课堂网址）"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="添加"
                                Style="{StaticResource OutlineButton}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="添加允许网站"
                                Click="AddAllowedSite_Click"/>
                      </Grid>
                      <Grid Margin="0,0,0,14">
                        <ItemsControl x:Name="AllowedSitesChips">
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                              <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,8,8"
                                      Padding="12,6,8,6"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      BorderThickness="1"
                                      CornerRadius="9"
                                      Background="{StaticResource AccentSoftBrush}"
                                      AutomationProperties.Name="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                                  <Button Content="×"
                                          Style="{StaticResource ChipRemove}"
                                          Tag="{Binding}"
                                          Click="RemoveAllowedSite_Click"
                                          ToolTip="从允许名单拿掉"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SiteAllowEmpty"
                                   Text="还没填。填了之后，浏览器只能打开这些网站。"
                                   Foreground="{StaticResource FaintBrush}"
                                   FontSize="12"
                                   Visibility="Collapsed"/>
                      </Grid>

                      <TextBlock Text="禁止类别" Style="{StaticResource FieldLabel}"/>
                      <StackPanel Margin="0,0,0,12">
                        <CheckBox x:Name="CatVideo"
                                  Content="短视频 / 直播（抖音、快手、B站…）"
                                  Style="{StaticResource QuietCheck}"
                                  Margin="0,2"
                                  Checked="Category_Changed"
                                  Unchecked="Category_Changed"/>
                        <CheckBox x:Name="CatGames"
                                  Content="游戏网站（4399、Steam 社区…）"
                                  Style="{StaticResource QuietCheck}"
                                  Margin="0,2"
                                  Checked="Category_Changed"
                                  Unchecked="Category_Changed"/>
                        <CheckBox x:Name="CatAdult"
                                  Content="成人内容"
                                  Style="{StaticResource QuietCheck}"
                                  Margin="0,2"
                                  Checked="Category_Changed"
                                  Unchecked="Category_Changed"/>
                      </StackPanel>

                      <TextBlock Text="禁止的网站" Style="{StaticResource FieldLabel}"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteBlockBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchBox}"
                                 Tag="如 youku.com"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="添加"
                                Style="{StaticResource OutlineButton}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="添加禁止网站"
                                Click="AddBlockedSite_Click"/>
                      </Grid>
                      <ItemsControl x:Name="BlockedSitesChips">
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,8,8"
                                    Padding="12,6,8,6"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Background="{StaticResource SurfaceHoverBrush}"
                                    AutomationProperties.Name="{Binding}">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                                <Button Content="×"
                                        Style="{StaticResource ChipRemove}"
                                        Tag="{Binding}"
                                        Click="RemoveBlockedSite_Click"
                                        ToolTip="从禁止名单拿掉"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>

                <!-- 时长 + 密码 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,22">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <TextBlock Text="每天屏幕时间" Style="{StaticResource SectionLabel}"/>
                      <UniformGrid Columns="2" Margin="0,2,0,8">
                        <RadioButton x:Name="DayTabWeekday" Content="周一至周五" GroupName="DayType"
                                     Style="{StaticResource DurationPill}" Margin="0,0,8,0"
                                     IsChecked="True" Checked="DayType_Checked"/>
                        <RadioButton x:Name="DayTabWeekend" Content="周末" GroupName="DayType"
                                     Style="{StaticResource DurationPill}" Margin="0,0,0,0" Checked="DayType_Checked"/>
                      </UniformGrid>
                      <TextBlock x:Name="DailyMinutesText"
                                 Text="1 小时"
                                 FontFamily="{StaticResource DisplayFont}"
                                 FontSize="34"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,4"/>
                      <TextBlock x:Name="OtherDaysText"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,12"/>
                      <UniformGrid Columns="2">
                        <RadioButton x:Name="Dur30" Content="30 分" Tag="30" GroupName="Duration"
                                     Style="{StaticResource DurationPill}" HorizontalAlignment="Stretch" Checked="Duration_Checked"/>
                        <RadioButton x:Name="Dur60" Content="1 小时" Tag="60" GroupName="Duration"
                                     Style="{StaticResource DurationPill}" HorizontalAlignment="Stretch" Checked="Duration_Checked"/>
                        <RadioButton x:Name="Dur90" Content="90 分" Tag="90" GroupName="Duration"
                                     Style="{StaticResource DurationPill}" HorizontalAlignment="Stretch" Checked="Duration_Checked"/>
                        <RadioButton x:Name="Dur120" Content="2 小时" Tag="120" GroupName="Duration"
                                     Style="{StaticResource DurationPill}" HorizontalAlignment="Stretch" Checked="Duration_Checked"/>
                        <RadioButton x:Name="DurCustom" Content="自定义" Tag="custom" GroupName="Duration"
                                     Style="{StaticResource DurationPill}" HorizontalAlignment="Stretch" Checked="Duration_Checked"/>
                      </UniformGrid>
                      <StackPanel x:Name="CustomMinutesPanel" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                        <TextBox x:Name="CustomMinutesBox"
                                 Style="{StaticResource SearchBox}"
                                 Width="84"
                                 LostFocus="CustomMinutes_LostFocus"
                                 KeyDown="CustomMinutes_KeyDown"
                                 AutomationProperties.Name="每天自定义分钟数"
                                 ToolTip="每天多少分钟（5–600）"/>
                        <TextBlock Text="分钟 / 天，范围 5–600" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                      </StackPanel>
                      <TextBlock x:Name="WhatHappensText"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 LineHeight="18"
                                 Margin="0,4,0,0"/>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>

                      <TextBlock Text="按星期排不同时长" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="默认按上面的基础时长。某天想多给或少给，在这里单独改，只有那一天生效。"
                                 Style="{StaticResource FieldLabel}" Margin="0,-4,0,12"/>
                      <ItemsControl x:Name="DayScheduleList" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}"
                                         FontSize="13" FontWeight="SemiBold"
                                         Foreground="{StaticResource InkBrush}"
                                         VerticalAlignment="Center"/>
                              <TextBox Grid.Column="1"
                                       Text="{Binding Minutes, UpdateSourceTrigger=LostFocus}"
                                       InputMethod.IsInputMethodEnabled="False"
                                       LostFocus="DayMinutes_LostFocus" KeyDown="DayMinutes_KeyDown"
                                       AutomationProperties.Name="{Binding Label, StringFormat='{}每天{0}的屏幕分钟数'}"
                                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                       Height="32" Margin="0,0,8,0">
                                <TextBox.Style>
                                  <Style TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
                                    <Setter Property="Tag" Value=""/>
                                    <Setter Property="Padding" Value="6,8"/>
                                    <Setter Property="FontSize" Value="14"/>
                                  </Style>
                                </TextBox.Style>
                              </TextBox>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="分" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="已单独设置"
                                           FontSize="10" Foreground="{StaticResource AccentBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>

                      <TextBlock Text="给单个软件单独限时" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="比如游戏每天只给 30 分钟，用完就只关掉它，别的软件照常用。"
                                 Style="{StaticResource FieldLabel}"
                                 Margin="0,-4,0,10"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LimitAppCombo"
                                  Grid.Column="0"
                                  Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key"
                                  AutomationProperties.Name="选择要限时的软件"/>
                        <TextBox x:Name="LimitMinutesBox"
                                 Grid.Column="1"
                                 Style="{StaticResource SearchBox}"
                                 Width="72"
                                 Margin="8,0,0,0"
                                 Tag="分钟"
                                 VerticalContentAlignment="Center"
                                 InputMethod.IsInputMethodEnabled="False"
                                 AutomationProperties.Name="这个软件每天能用多少分钟"
                                 ToolTip="每天 5–600 分钟"/>
                      </Grid>
                      <Button Content="加上这条限额"
                              Style="{StaticResource OutlineButton}"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="添加软件限额"
                              Click="AddAppLimit_Click"/>
                      <ItemsControl x:Name="AppLimitList" Margin="0,10,0,0">
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10,8,8,8"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Background="{StaticResource SurfaceHoverBrush}"
                                    AutomationProperties.Name="{Binding Summary}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                <Button Grid.Column="2"
                                        Content="×"
                                        Style="{StaticResource ChipRemove}"
                                        Tag="{Binding Key}"
                                        Click="RemoveAppLimit_Click"
                                        ToolTip="取消这条限额"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock x:Name="AppLimitEmpty"
                                 Text="还没有单独限时。所有软件共用上面的每天总时长。"
                                 Foreground="{StaticResource FaintBrush}"
                                 FontSize="12"/>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>

                      <StackPanel x:Name="FirstRunPinPanel">
                        <TextBlock Text="家长密码" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="至少 4 位，改规则和退出都要用" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PinCreateBox"
                                     Style="{StaticResource FieldPassword}"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="改规则、加时间、退出澄时都要用"/>
                        <TextBlock Text="再输一次" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="PinConfirmBox"
                                     Style="{StaticResource FieldPassword}"
                                     InputMethod.IsInputMethodEnabled="False"/>
                      </StackPanel>

                      <StackPanel x:Name="ConfiguredPinPanel" Visibility="Collapsed">
                        <TextBlock Text="家长" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="找回码" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0"
                                  Background="{StaticResource CanvasBrush}"
                                  BorderBrush="{StaticResource LineBrush}"
                                  BorderThickness="1"
                                  CornerRadius="9"
                                  Padding="14,12">
                            <TextBlock x:Name="RecoveryCodeText"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="18"
                                       Text="————"
                                       AutomationProperties.Name="家长密码找回码"/>
                          </Border>
                          <Button Grid.Column="1"
                                  Content="复制"
                                  Style="{StaticResource OutlineButton}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Stretch"
                                  AutomationProperties.Name="复制找回码"
                                  Click="CopyRecovery_Click"/>
                        </Grid>
                        <TextBlock x:Name="RecoveryHint"
                                   Text="忘记密码时用，请抄下来或点「复制」存好。"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="当前密码" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PinOldBox"
                                     Style="{StaticResource FieldPassword}"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="当前密码"/>
                        <TextBlock Text="新密码" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="PinNewBox"
                                     Style="{StaticResource FieldPassword}"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="新密码"/>
                        <TextBlock Text="再输一次" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="PinNewConfirmBox"
                                     Style="{StaticResource FieldPassword}"
                                     InputMethod.IsInputMethodEnabled="False"
                                     ToolTip="再输一次新密码"/>
                        <Button Content="保存新密码"
                                Style="{StaticResource OutlineButton}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="ChangePin_Click"/>
                        <TextBlock x:Name="PinChangeHint"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                      </StackPanel>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>
                      <TextBlock Text="邮箱找回（可选）" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="留一个备用邮箱，忘记密码时用验证码找回，比记找回码更方便。"
                                 Style="{StaticResource FieldLabel}" Margin="0,-4,0,10" TextWrapping="Wrap"/>
                      <TextBlock Text="备用邮箱" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="RecoveryEmailBox"
                               Style="{StaticResource SearchBox}"
                               InputMethod.IsInputMethodEnabled="False"
                               Tag="parent@example.com"
                               Margin="0,0,0,4"/>
                      <Button Content="保存备用邮箱"
                              Style="{StaticResource OutlineButton}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              Click="SaveRecoveryEmail_Click"/>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>
                      <TextBlock Text="邮件发送设置（可选）" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="不填也能用：演示模式会在软件内直接弹出验证码。想真发邮件，填 QQ/新浪 的 SMTP（用邮箱授权码，不是登录密码）。"
                                 Style="{StaticResource FieldLabel}" Margin="0,-4,0,10" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="QQ 邮箱" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="MailPreset_Click" Tag="qq"/>
                        <Button Content="新浪邮箱" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="MailPreset_Click" Tag="sina"/>
                        <Button Content="163 邮箱" Style="{StaticResource OutlineButton}" Click="MailPreset_Click" Tag="163"/>
                      </StackPanel>
                      <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SMTP 服务器" Style="{StaticResource FieldLabel}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SmtpHostBox" Grid.Column="1" Style="{StaticResource SearchBox}" InputMethod.IsInputMethodEnabled="False" Tag="smtp.qq.com"/>
                        <TextBlock Text="端口" Style="{StaticResource FieldLabel}" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <TextBox x:Name="SmtpPortBox" Grid.Column="3" Style="{StaticResource SearchBox}" InputMethod.IsInputMethodEnabled="False" Tag="587"/>
                      </Grid>
                      <CheckBox x:Name="SmtpSslBox" Content="使用 SSL/TLS 加密" Style="{StaticResource QuietCheck}" Margin="0,10,0,0" IsChecked="True"/>
                      <TextBlock Text="邮箱账号" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                      <TextBox x:Name="SmtpUserBox" Style="{StaticResource SearchBox}" InputMethod.IsInputMethodEnabled="False" Tag="你的邮箱"/>
                      <TextBlock Text="授权码（不是邮箱登录密码）" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                      <PasswordBox x:Name="SmtpPassBox" Style="{StaticResource FieldPassword}" InputMethod.IsInputMethodEnabled="False"/>
                      <Button Content="保存邮件设置"
                              Style="{StaticResource OutlineButton}"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Left"
                              Click="SaveMail_Click"/>
                      <TextBlock x:Name="MailHint"
                                 FontSize="12"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="0,8,0,0"
                                 TextWrapping="Wrap"/>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>
                      <TextBlock Text="守护服务（开机自启 · 防强杀）" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="把守护装成系统服务后：开机自动守护、孩子杀不掉进程；不装则只在软件运行时生效，重启电脑后不自动守护。"
                                 Style="{StaticResource FieldLabel}" Margin="0,-4,0,10" TextWrapping="Wrap"/>
                      <TextBlock x:Name="ServiceStatusText"
                                 FontSize="12"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,0,10"
                                 TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallServiceButton"
                                Content="安装守护服务"
                                Style="{StaticResource OutlineButton}"
                                Margin="0,0,8,0"
                                Click="InstallService_Click"/>
                        <Button x:Name="UninstallServiceButton"
                                Content="卸载守护服务"
                                Style="{StaticResource GhostButton}"
                                Visibility="Collapsed"
                                Click="UninstallService_Click"/>
                      </StackPanel>

                      <CheckBox x:Name="StartWithWindowsBox"
                                Content="开机时启动澄时"
                                Style="{StaticResource QuietCheck}"
                                Margin="0,20,0,0"
                                IsChecked="True"
                                Checked="StartWithWindows_Changed"
                                Unchecked="StartWithWindows_Changed"/>

                      <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>

                      <TextBlock Text="睡觉时间" Style="{StaticResource SectionLabel}"/>
                      <CheckBox x:Name="BedtimeBox"
                                Content="22:00 – 07:00 断网"
                                Style="{StaticResource QuietCheck}"
                                Checked="Bedtime_Changed"
                                Unchecked="Bedtime_Changed"/>
                <TextBlock Text="守护期间到点就断网，帮助孩子按时睡觉。"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="28,4,0,0"/>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,18"/>

                <TextBlock Text="护眼休息提醒" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="孩子连续用电脑到设定时长，就弹窗温柔提醒休息眼睛。只是提醒，不会强制关掉软件。"
                           Style="{StaticResource FieldLabel}" Margin="0,-4,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="BreakOff" Content="关闭" Tag="0" GroupName="BreakReminder"
                               Style="{StaticResource DurationPill}" Margin="0,0,8,8" Checked="BreakReminder_Changed"/>
                  <RadioButton x:Name="Break30" Content="每 30 分钟" Tag="30" GroupName="BreakReminder"
                               Style="{StaticResource DurationPill}" Margin="0,0,8,8" Checked="BreakReminder_Changed"/>
                  <RadioButton x:Name="Break45" Content="每 45 分钟" Tag="45" GroupName="BreakReminder"
                               Style="{StaticResource DurationPill}" Margin="0,0,8,8" Checked="BreakReminder_Changed"/>
                  <RadioButton x:Name="Break60" Content="每 60 分钟" Tag="60" GroupName="BreakReminder"
                               Style="{StaticResource DurationPill}" Checked="BreakReminder_Changed"/>
                </StackPanel>
              </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>

              <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock x:Name="ParentHint"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
              </DockPanel>
            </Grid>

            <!-- ===== 帮助页 ===== -->
            <Grid x:Name="HelpPage" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="帮助与状态"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Text="确认守护引擎在正常工作，或试一下拦截效果。"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="守护引擎" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="HelpEngineText"
                               Text=""
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="验证拦截" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="开始后只留计算器，打开记事本应被自动关掉。用来确认拦截有没有生效。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,0,0,12"/>
                    <Button x:Name="SpikeLink"
                            Content="试一下拦截"
                            Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Left"
                            Click="Spike_Click"/>
                    <TextBlock x:Name="SpikeHintText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="24,22">
                  <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="HelpAboutText"
                               Text="澄时 1.0.0 · 所有设置和记录都只存在这台电脑上，不会上传。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- ===== 孩子视图（守护中）：书桌场景 ui-02 + 时间用完夜晚场景 ui-03 ===== -->
          <Grid x:Name="ChildRoot" Visibility="Collapsed" Background="{StaticResource KidDeskBackdrop}">
            <Grid Margin="36,24,36,24">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 书桌进行中：白名单应用磁贴 + 大倒计时 -->
              <Grid x:Name="DeskPanel" Grid.Row="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="ChildPillDot" Width="8" Height="8" Fill="#5BB98C" VerticalAlignment="Center"/>
                      <TextBlock x:Name="ChildCaption"
                                 Text="今天还剩"
                                 FontSize="12"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="7,0,0,0"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="RemainingText"
                             HorizontalAlignment="Center"
                             FontFamily="{StaticResource DisplayFont}"
                             FontSize="92"
                             FontWeight="Light"/>
                  <TextBlock x:Name="ChildHint"
                             HorizontalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="13"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             MaxWidth="440"
                             Margin="0,12,0,0"/>
                </StackPanel>

                <ItemsControl x:Name="ChildAppChips"
                              Grid.Row="1"
                              Margin="0,8,0,10"
                              MaxHeight="170"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="112"
                              Margin="8"
                              Padding="14,16,14,13"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              CornerRadius="16"
                              AutomationProperties.Name="{Binding DisplayName}">
                        <StackPanel>
                          <Border Width="48" Height="48" CornerRadius="13"
                                  Background="{StaticResource AccentSoftBrush}"
                                  HorizontalAlignment="Center">
                            <Path Data="M 3,3 H 7.2 V 7.2 H 3 Z M 8.8,3 H 13 V 7.2 H 8.8 Z M 3,8.8 H 7.2 V 13 H 3 Z M 8.8,8.8 H 13 V 13 H 8.8 Z"
                                  Width="17" Height="17" Stretch="Fill"
                                  Fill="{StaticResource AccentBrush}"/>
                          </Border>
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="12"
                                     Foreground="{StaticResource InkBrush}"
                                     HorizontalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="82"
                                     Margin="0,10,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="BlockedList"
                              Grid.Row="2"
                              Margin="0,0,0,6"
                              MaxHeight="56"
                              HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="4" Padding="12,6" Background="#F6EFEA" BorderBrush="#EAD9CE"
                              BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource WarnBrush}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <!-- 时间用完：夜晚锁屏（对应设计稿 ui-03） -->
              <Grid x:Name="TimeUpPanel" Grid.Row="0" Visibility="Collapsed">
                <Border Background="{StaticResource NightBackdrop}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,28,40,64" MaxWidth="560">
                    <Canvas Width="176" Height="118" HorizontalAlignment="Center" Margin="0,0,0,10" IsHitTestVisible="False">
                      <!-- 月亮 -->
                      <Path Fill="{StaticResource MoonBrush}"
                            Data="M 78,6 A 50,50 0 1 0 78,106 A 40,40 0 1 1 78,6 Z"/>
                      <Path Data="M 36,50 Q 40,55 44,50 M 52,60 Q 56,65 60,60 M 40,72 Q 48,79 56,72"
                            Stroke="#C79A4B" StrokeThickness="2.4"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      <!-- 闹钟 -->
                      <Ellipse Canvas.Left="106" Canvas.Top="34" Width="60" Height="60"
                               Fill="#F4F3FB" Stroke="#D9DCEF" StrokeThickness="3"/>
                      <Ellipse Canvas.Left="99" Canvas.Top="26" Width="16" Height="16" Fill="#D9DCEF"/>
                      <Ellipse Canvas.Left="157" Canvas.Top="26" Width="16" Height="16" Fill="#D9DCEF"/>
                      <Path Data="M 136,64 L 136,48 M 136,64 L 148,68"
                            Stroke="#37325C" StrokeThickness="3"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Ellipse Canvas.Left="132.5" Canvas.Top="60.5" Width="7" Height="7" Fill="#37325C"/>
                      <Path Data="M 116,90 L 110,99 M 156,90 L 162,99"
                            Stroke="#D9DCEF" StrokeThickness="3"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Ellipse Canvas.Left="168" Canvas.Top="12" Width="5" Height="5" Fill="#8B8FB8"/>
                      <Ellipse Canvas.Left="88" Canvas.Top="14" Width="3" Height="3" Fill="#8B8FB8"/>
                    </Canvas>
                    <TextBlock Text="今天的时间用完啦"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NightTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TimeUpHint"
                               Text=""
                               Foreground="{StaticResource NightMutedBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="460"
                               Margin="0,12,0,0"/>
                    <Button x:Name="AskMoreButton"
                            Content="申请加时"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            MinWidth="300"
                            MinHeight="46"
                            FontSize="15"
                            Margin="0,28,0,0"
                            Visibility="Collapsed"
                            Click="AskMore_Click"/>
                    <TextBlock Text="加时只对今天有效，跨天自动清零 · 忘记密码可用找回码重置"
                               FontSize="11"
                               Foreground="{StaticResource NightFaintBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                  </StackPanel>
                </ScrollViewer>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,20"
                        Background="#26FFFFFF" CornerRadius="10" Padding="12,6">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 6,1 L 11,3.5 L 11,7 C 11,10 9,11.6 6,13 C 3,11.6 1,10 1,7 L 1,3.5 Z"
                          Stroke="{StaticResource NightMutedBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="14" Stretch="Fill" VerticalAlignment="Center"/>
                    <TextBlock Text="澄时守护中"
                               FontSize="12"
                               Foreground="{StaticResource NightMutedBrush}"
                               Margin="7,0,0,0"/>
                  </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20"
                        Background="#26FFFFFF" CornerRadius="10" Padding="12,6">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource MoonBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="睡觉时段 22:00 – 07:00"
                               FontSize="12"
                               Foreground="{StaticResource NightMutedBrush}"
                               Margin="7,0,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Button x:Name="AskParentButton"
                      Grid.Row="1"
                      Content="找家长（改时间 / 软件 / 退出）"
                      Style="{StaticResource OutlineButton}"
                      HorizontalAlignment="Center"
                      MinWidth="240"
                      Margin="0,10,0,0"
                      Click="AskParent_Click"/>
            </Grid>
          </Grid>

          <!-- 护眼休息提醒遮罩（守护中弹出，温柔不强制） -->
          <Grid x:Name="BreakOverlay" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="#8A1B1917"/>
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="34,30">
              <StackPanel>
                <Canvas Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <Ellipse Width="84" Height="84" Fill="{StaticResource AccentSoftBrush}"/>
                  <Path Data="M 24,42 C 33,33 51,33 60,42 C 51,51 33,51 24,42 Z"
                        Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Ellipse Canvas.Left="37" Canvas.Top="37" Width="10" Height="10" Fill="{StaticResource AccentBrush}"/>
                </Canvas>
                <TextBlock Text="该让眼睛休息一下啦"
                           FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="你已经连续看了好一会儿屏幕。站起来走走，看看远处，5 分钟就好。"
                           Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,10,0,22" TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="好的，休息一下" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0,0,10,0" Click="BreakDismiss_Click"/>
                  <Button Content="再看一会儿" Style="{StaticResource OutlineButton}" MinWidth="120" Click="BreakDismiss_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>

<Window x:Class="Chengshi.App.ExtendTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="申请加时"
        Height="380"
        Width="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        FocusManager.FocusedElement="{Binding ElementName=Extra15}">
  <Border Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Margin="1">
    <Grid Margin="30,26,30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Canvas Width="22" Height="22" VerticalAlignment="Center">
          <Path Data="M 11,2 C 6,2 2,6 2,11 C 2,16 6,20 11,20 C 16,20 20,16 20,11 C 20,6 16,2 11,2 Z M 10,5 L 12,5 L 12,11 L 16,13 L 15,15 L 10,12 Z"
                Fill="{StaticResource AccentBrush}"/>
        </Canvas>
        <TextBlock Text="申请加时"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Grid.Row="1"
                 Text="孩子说时间不够用了。选加多久，输入家长密码批准；不加就直接关掉这个窗口。"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}"
                 FontSize="13"
                 Margin="0,8,0,18"/>

      <StackPanel Grid.Row="2">
        <UniformGrid Columns="3">
          <RadioButton x:Name="Extra15" Content="15 分钟" Tag="15" GroupName="ExtraMinutes"
                       Style="{StaticResource DurationPill}" Margin="0,0,8,8"
                       AutomationProperties.Name="加十五分钟"/>
          <RadioButton x:Name="Extra30" Content="30 分钟" Tag="30" GroupName="ExtraMinutes"
                       Style="{StaticResource DurationPill}" IsChecked="True" Margin="0,0,8,8"
                       AutomationProperties.Name="加三十分钟"/>
          <RadioButton x:Name="Extra60" Content="1 小时" Tag="60" GroupName="ExtraMinutes"
                       Style="{StaticResource DurationPill}" AutomationProperties.Name="加一小时"/>
        </UniformGrid>

        <TextBlock Text="家长密码"
                   Style="{StaticResource FieldLabel}"
                   Margin="0,6,0,6"/>
        <PasswordBox x:Name="PinBox"
                     Style="{StaticResource FieldPassword}"
                     InputMethod.IsInputMethodEnabled="False"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource WarnBrush}"
                   FontSize="13"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
        <TextBlock Text="加时只对今天有效，跨天自动清零。"
                   Style="{StaticResource FieldLabel}"
                   Margin="0,10,0,0"/>
      </StackPanel>

      <DockPanel Grid.Row="3" Margin="0,20,0,0">
        <Button DockPanel.Dock="Right"
                Content="批准加时"
                Style="{StaticResource PrimaryButton}"
                Click="Ok_Click"
                IsDefault="True"
                MinWidth="104"/>
        <Button Content="这次不给"
                Style="{StaticResource GhostButton}"
                Click="Cancel_Click"
                IsCancel="True"
                HorizontalAlignment="Left"
                Padding="0"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>

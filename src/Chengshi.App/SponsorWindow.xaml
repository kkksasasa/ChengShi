<Window x:Class="Chengshi.App.SponsorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="支持澄时"
        Height="620"
        Width="720"
        MinHeight="560"
        MinWidth="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 标题栏 -->
      <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Canvas Width="20" Height="20" VerticalAlignment="Center">
            <Path Data="M 10,2 C 6,2 3,5 3,9 C 3,13 7,16 10,18 C 13,16 17,13 17,9 C 17,5 14,2 10,2 Z M 8,9 L 9.5,10.5 L 12.5,7"
                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Canvas>
          <TextBlock Text="支持澄时"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CloseButton" Content="×" Style="{StaticResource ChromeButton}" Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" FontSize="16"/>
        </StackPanel>
        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
      </Grid>

      <Grid Grid.Row="1" Margin="30,22,30,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="澄时对所有家庭免费，也没有任何广告。"
                     FontSize="14"/>
          <TextBlock Text="如果它帮你省了心，可以请作者（一位爸爸）喝杯咖啡——扫码时备注一下昵称，都会记在心里。当然，不用也完全没关系，澄时照常好用。"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     LineHeight="18"
                     Margin="0,6,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2">
          <!-- 支付宝 -->
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Border Width="22" Height="22" CornerRadius="5" Background="#1677FF">
                  <TextBlock Text="支" FontSize="13" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="支付宝" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Image Grid.Row="1"
                     Source="/Assets/donate-alipay.jpg"
                     Stretch="Uniform"
                     AutomationProperties.Name="支付宝收款码"/>
            </Grid>
          </Border>

          <!-- 微信 -->
          <Border Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Border Width="22" Height="22" CornerRadius="5" Background="#07C160">
                  <TextBlock Text="微" FontSize="13" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="微信支付" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Image Grid.Row="1"
                     Source="/Assets/donate-wechat.jpg"
                     Stretch="Uniform"
                     AutomationProperties.Name="微信收款码"/>
            </Grid>
          </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2"
                   Text="用手机「扫一扫」上面的码即可。金额随意，心意最重要。"
                   Foreground="{StaticResource FaintBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0"/>
      </Grid>
    </Grid>
  </Border>
</Window>
